# Use localhost by default to avoid LAN IP reachability issues during dev.
# If you need to access from another device on the LAN, change to
#   http://<your-computer-lan-ip>:8124/api
NUXT_PUBLIC_API_BASE=
NUXT_PUBLIC_RANDOM_IMAGE_API_URL=https://pic.zz4th.space/
NUXT_PUBLIC_ENABLE_SSR=false
NUXT_PUBLIC_PAGE_SIZE=20

# 中国大陆 jsDelivr 镜像域名（用于需要拼接 jsDelivr 链接时）
# 常见可选：https://fastly.jsdelivr.net 或 https://gcore.jsdelivr.net
NUXT_PUBLIC_JSDELIVR_ORIGIN=https://fastly.jsdelivr.net
